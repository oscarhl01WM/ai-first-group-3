{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://munch-cr.invalid/schemas/recipes-v1.json",
  "title": "Munch CR recipe catalog v1",
  "type": "object",
  "required": ["schemaVersion", "catalogId", "isSynthetic", "recipes"],
  "properties": {
    "schemaVersion": {"const": 1},
    "catalogId": {"type": "string", "minLength": 1},
    "isSynthetic": {"type": "boolean"},
    "recipes": {"type": "array", "items": {"$ref": "#/$defs/recipe"}}
  },
  "additionalProperties": false,
  "$defs": {
    "quantity": {
      "type": "object", "required": ["amount", "unit"],
      "properties": {"amount": {"type": "number", "exclusiveMinimum": 0}, "unit": {"enum": ["g", "ml", "count"]}},
      "additionalProperties": false
    },
    "recipeIngredient": {
      "type": "object", "required": ["ingredientId", "quantity"],
      "properties": {"ingredientId": {"type": "string", "minLength": 1}, "quantity": {"$ref": "#/$defs/quantity"}},
      "additionalProperties": false
    },
    "instruction": {
      "type": "object", "required": ["step", "text"],
      "properties": {"step": {"type": "integer", "minimum": 1}, "text": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "recipe": {
      "type": "object",
      "required": ["id", "versionId", "name", "description", "baseServings", "minutes", "mealTypes", "dietaryTags", "appliances", "reviewStatus", "ingredients", "instructions"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "versionId": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1}, "description": {"type": "string"},
        "baseServings": {"type": "integer", "minimum": 1}, "minutes": {"type": "integer", "minimum": 0},
        "mealTypes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["breakfast", "lunch", "dinner"]}},
        "dietaryTags": {"type": "array", "uniqueItems": true, "items": {"enum": ["vegetarian", "vegan"]}},
        "appliances": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "reviewStatus": {"enum": ["draft", "approved", "rejected", "mock"]},
        "ingredients": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/recipeIngredient"}},
        "instructions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/instruction"}}
      },
      "additionalProperties": false
    }
  }
}
